{
  "name": "oni-agent",
  "private": true,
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "lint": "oxlint",
    "preview": "vite preview",
    "ingest": "tsx electron/workers/ingest.ts",
    "migrate": "tsx scripts/migrate_json_to_lancedb.ts"
  },
  "build": {
    "appId": "com.oniagent.app",
    "productName": "ONI Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "data/lancedb",
        "to": "data/lancedb",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "data/custom_guides",
        "to": "data/custom_guides",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "data/meta.json",
        "to": "data/meta.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ONI Agent"
    }
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.31.0",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.3",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.5",
    "@langchain/textsplitters": "^1.0.1",
    "@types/jsdom": "^28.0.3",
    "adm-zip": "^0.6.0",
    "apache-arrow": "^21.2.0",
    "cheerio": "^1.2.0",
    "chromadb": "^3.5.0",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.4",
    "jsdom": "^29.1.1",
    "langchain": "^1.5.3",
    "lucide-react": "^1.25.0",
    "mermaid": "^11.16.0",
    "ollama": "^0.6.3",
    "puppeteer-core": "^25.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "sass": "^1.101.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
